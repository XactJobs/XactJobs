---
// A dashboard screenshot from ../docs/images in the docs, light or dark with the page (Starlight's light:/dark:sl-hidden).
// The dark one is <name>-dark.png. /llms-full.txt turns it into a markdown image of the light one (src/lib/llms.ts).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
}

const { name, alt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../../../docs/images/*.png', { eager: true });
const find = (file: string) => {
  const image = images[`../../../docs/images/${file}.png`];
  if (!image) throw new Error(`docs/images/${file}.png doesn't exist`);
  return image.default;
};

const sizes = '(min-width: 72rem) 45rem, calc(100vw - 2rem)';
const widths = [720, 1080, 1440];
---

<Image src={find(name)} alt={alt} widths={widths} sizes={sizes} class="dark:sl-hidden" />
<Image src={find(`${name}-dark`)} alt={alt} widths={widths} sizes={sizes} class="light:sl-hidden" />
