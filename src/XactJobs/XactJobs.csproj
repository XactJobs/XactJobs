<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<Description>Background jobs for EF Core that commit in the same transaction as your data. SQL Server, PostgreSQL, MySQL, Oracle and SQLite.</Description>
	</PropertyGroup>

	<Import Project="..\Package.props" />

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- the benchmarks measure the serializer, the compiler and the save check directly -->
		<InternalsVisibleTo Include="XactJobs.Benchmarks" />
		<!-- the tests check the attributes of methods that can't be periodic jobs, which no assembly scan of theirs may find -->
		<InternalsVisibleTo Include="XactJobs.Tests" />
	</ItemGroup>

	<!-- EF Core 10 only targets net10.0, and EF Core 9 targets net8.0 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
	</ItemGroup>

</Project>
