<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<Description>Dashboard UI for XactJobs background job processing library.</Description>
	</PropertyGroup>

	<Import Project="..\Package.props" />

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- the dashboard's scripts, styles and fonts, served by MapXactJobsUI (not a wwwroot: no static web assets) -->
		<EmbeddedResource Include="Assets\**" LogicalName="XactJobs.UI/Assets/%(RecursiveDir)%(Filename)%(Extension)" />
		<None Remove="Assets\**" />
		<Content Remove="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\XactJobs\XactJobs.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
