@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.Extensions.Options
@inject XactJobsUIOptions Options
@inject IAntiforgery Antiforgery
@inject IOptions<AntiforgeryOptions> AntiforgeryOptions
@{
    var basePath = Url.Content("~" + Options.BasePath);
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="xactjobs-antiforgery" content="@antiforgeryToken" data-header="@AntiforgeryOptions.Value.HeaderName" />
    <title>@ViewData["Title"] - @Options.DashboardTitle</title>

    @* served from the package (wwwroot/lib), so the dashboard works without internet access and under a strict CSP *@
    <link href="~/_content/XactJobs.UI/lib/bootstrap/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/_content/XactJobs.UI/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/_content/XactJobs.UI/css/xactjobs.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="@basePath">
                <i class="bi bi-gear-wide-connected me-2"></i>@Options.DashboardTitle
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="@basePath"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@basePath/scheduled"><i class="bi bi-clock me-1"></i>Scheduled</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@basePath/history/succeeded"><i class="bi bi-check-circle me-1"></i>Succeeded</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@basePath/history/failed"><i class="bi bi-x-circle me-1"></i>Failed</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@basePath/periodic"><i class="bi bi-arrow-repeat me-1"></i>Periodic</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid py-4">
        @RenderBody()
    </main>

    <div id="xj-toasts" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

    <!-- Error details, filled from the data attributes of the button that opens it -->
    <div class="modal fade" id="xj-error-modal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>Error Details - Job #<span data-xj-field="id"></span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <h6>Error Message</h6>
                    <pre class="bg-light p-3 rounded text-wrap" data-xj-field="message"></pre>
                    <div data-xj-section="stack">
                        <h6 class="mt-3">Stack Trace</h6>
                        <pre class="bg-dark text-light p-3 rounded small" style="max-height: 400px; overflow-y: auto;" data-xj-field="stack"></pre>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/_content/XactJobs.UI/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/_content/XactJobs.UI/lib/chart.js/chart.umd.js" asp-append-version="true"></script>
    <script src="~/_content/XactJobs.UI/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script src="~/_content/XactJobs.UI/js/xactjobs.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
