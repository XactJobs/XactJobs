@model CursorPaginationModel

<nav class="mt-4">
    <ul class="pagination justify-content-center">
        @if (Model.NewerCursor != null)
        {
            <li class="page-item">
                <a class="page-link" href="?@Model.Owner.CursorQuery(Model.NewerCursor).TrimStart('&')">
                    <i class="bi bi-chevron-left"></i> Newer
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link"><i class="bi bi-chevron-left"></i> Newer</span>
            </li>
        }

        <li class="page-item disabled">
            <span class="page-link">@Model.DisplayTotal total</span>
        </li>

        @if (Model.OlderCursor != null)
        {
            <li class="page-item">
                <a class="page-link" href="?@Model.Owner.CursorQuery(Model.OlderCursor).TrimStart('&')">
                    Older <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link">Older <i class="bi bi-chevron-right"></i></span>
            </li>
        }
    </ul>
</nav>
