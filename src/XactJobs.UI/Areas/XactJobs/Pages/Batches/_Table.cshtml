@model XactJobs.UI.Pages.Batches.IndexModel

@if (Model.Batches.Items.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No batches found.
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Batch</th>
                        <th>Job</th>
                        <th>Progress</th>
                        <th>Continuations</th>
                        <th>@(Model.State == BatchState.Active ? "Next Run" : "Finished At")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in Model.Batches.Items)
                    {
                        <tr>
                            <td><a href="@Model.BatchUrl(batch.Id)" title="@batch.Id"><code>@batch.DisplayId</code></a></td>
                            <td>
                                @if (batch.TypeName != null)
                                {
                                    <span title="@batch.TypeName">@batch.DisplayTypeName</span><code class="ms-1" title="@batch.MethodName">@batch.DisplayMethodName</code>
                                    @if (batch.TotalJobs > 1)
                                    {
                                        <span class="text-muted small">and @(batch.TotalJobs - 1) more</span>
                                    }
                                }
                            </td>
                            <td style="min-width: 14rem;">
                                <partial name="~/Areas/XactJobs/Pages/Partials/_BatchProgress.cshtml" model="batch" />
                            </td>
                            <td>
                                @if (batch.AwaitingContinuations > 0)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border"><i class="bi bi-hourglass"></i> @batch.AwaitingContinuations waiting</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (Model.State == BatchState.Finished)
                                {
                                    @XactJobsPageModel.Time(batch.LastProcessedAt)
                                }
                                else if (batch.RunningJobs > 0)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-play-circle"></i> @batch.RunningJobs running</span>
                                }
                                else if (batch.NextRunAt != null)
                                {
                                    @XactJobsPageModel.Time(batch.NextRunAt)
                                }
                                else
                                {
                                    <span class="text-muted" title="All of its jobs are continuations that wait for another batch">After another batch</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="~/Areas/XactJobs/Pages/Partials/_Pagination.cshtml" model="new PaginationModel(Model, Model.Batches.Page, Model.Batches.TotalPages, Model.Batches.TotalCount)" />
}
