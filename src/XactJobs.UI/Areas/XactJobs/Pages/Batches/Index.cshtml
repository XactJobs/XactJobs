@page "{state?}"
@model XactJobs.UI.Pages.Batches.IndexModel
@{
    ViewData["Title"] = Model.Current.Title + " Batches";
}

<div class="row mb-3">
    <div class="col">
        <h1><i class="bi bi-collection me-2"></i>Batches</h1>
        <p class="text-muted">@Model.Current.Description</p>
    </div>
    <div class="col-auto d-flex align-items-center gap-3">
        <button class="btn btn-outline-secondary" onclick="htmx.trigger(document.body, 'xactjobs-changed')">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    @foreach (var state in XactJobs.UI.Pages.Batches.IndexModel.States)
    {
        <li class="nav-item">
            <a class="nav-link @(state.State == Model.State ? "active" : "")" href="@Model.StateUrl(state.State)">
                <i class="bi @state.Icon me-1"></i>@state.Title
            </a>
        </li>
    }
</ul>

<div hx-get="@Model.TableUrl"
     hx-trigger="every @(Model.Options.RefreshIntervalSeconds)s [!xactJobsIsBusy()], xactjobs-changed from:body"
     hx-swap="innerHTML">
    <partial name="_Table" model="Model" />
</div>
