<Project>

	<!-- the NuGet packages' common settings, imported by XactJobs and XactJobs.UI: the version is changed here, for both -->
	<PropertyGroup>
		<Version>1.0.0-rc5</Version>
		<RepositoryUrl>https://github.com/XactJobs/XactJobs</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>XactJobs</Authors>
		<Copyright>Copyright (c) 2025 XactJobs</Copyright>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://xactjobs.com/</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>

		<!-- symbols on nuget.org (.snupkg), with Source Link (in the SDK): a debugger steps into the source of the commit built -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>

		<!-- deterministic, with the paths normalized: the same commit builds the same assemblies on any machine -->
		<ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>

		<!-- the package is compared with the last release when it's built: an API removed or changed, or a target framework dropped, fails
		     the build unless it's listed in the project's CompatibilitySuppressions.xml, on purpose -->
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>1.0.0-rc1</PackageValidationBaselineVersion>
	</PropertyGroup>

	<!-- the public API, listed in PublicAPI.Shipped.txt (released) and PublicAPI.Unshipped.txt (since the last release) next to the
	     project: a change to it fails the build until the lists are updated, so it shows in the pull request -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)XactJobs\icon.png" Link="icon.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Link="README.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>

</Project>
